<UserControl x:Class="DtmToolbox.Views.ChartPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DtmToolbox.Controls">
    <DockPanel>

        <!-- Communication failure -->
        <Border DockPanel.Dock="Top" Margin="16,16,16,0" Padding="14,10" Background="{StaticResource DangerBrush}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBox Style="{StaticResource SelectableText}" Foreground="{StaticResource WhiteBrush}" Text="{Binding ErrorMessage, Mode=OneWay}" />
        </Border>

        <Border Margin="16" Background="{StaticResource WhiteBrush}">
            <Grid>
                <controls:ChannelChart Values="{Binding ChartValues}" IsReceiver="{Binding ChartIsReceiver}"
                                       MinimumDbm="-40" MaximumDbm="20" />

                <!-- The test is running in the other tab -->
                <Border Background="{StaticResource WhiteBrush}"
                        Visibility="{Binding ShowWrongTabNotice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" TextWrapping="Wrap"
                               Margin="40" Foreground="{StaticResource Gray600Brush}" Text="{Binding WrongTabText}" />
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
