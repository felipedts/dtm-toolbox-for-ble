<Window x:Class="DtmToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DtmToolbox.Views"
        Title="DTM Toolbox for BLE"
        Width="1280" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        Background="{StaticResource Gray50Brush}">
    <DockPanel>

        <!-- Bottom bar -->
        <Grid DockPanel.Dock="Bottom" Height="32" Background="{StaticResource Gray800Brush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Gray300Brush}" Padding="24,0">
                <CheckBox Style="{StaticResource Switch}" Foreground="{StaticResource Gray900Brush}"
                          Content="SHOW SIDE PANEL" IsChecked="{Binding ShowSidePanel}" />
            </Border>

            <DockPanel Grid.Column="1" Margin="16,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox Style="{StaticResource Switch}" Content="RAW FRAMES" IsChecked="{Binding ShowRawFrames}" Margin="0,0,20,0" />
                    <CheckBox Style="{StaticResource Switch}" Content="AUTOSCROLL LOG" IsChecked="{Binding AutoScrollLog}" Margin="0,0,20,0" />
                    <CheckBox Style="{StaticResource Switch}" Content="SHOW LOG" IsChecked="{Binding ShowLog}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BarButton}" Content="CLEAR LOG" Command="{Binding ClearLogCommand}" />
                    <Button Style="{StaticResource BarButton}" Content="COPY LOG" Click="OnCopyLogClick" />
                    <Button Style="{StaticResource BarButton}" Content="SAVE LOG" Command="{Binding SaveLogCommand}" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Side panel -->
        <views:SidePanel DockPanel.Dock="Left" Width="260"
                         Visibility="{Binding ShowSidePanel, Converter={StaticResource BoolToVisibility}}" />

        <!-- Tabs -->
        <Border DockPanel.Dock="Top" Height="40" Background="{StaticResource WhiteBrush}" Padding="16,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TabHeader}" GroupName="MainTabs" Content="TRANSMITTER" IsChecked="{Binding IsTransmitterTab}" />
                <RadioButton Style="{StaticResource TabHeader}" GroupName="MainTabs" Content="RECEIVER" IsChecked="{Binding IsReceiverTab}" />
                <RadioButton Style="{StaticResource TabHeader}" GroupName="MainTabs" Content="ABOUT" IsChecked="{Binding IsAboutTab}" />
            </StackPanel>
        </Border>

        <!-- Log -->
        <views:LogPane x:Name="LogView" DockPanel.Dock="Bottom" Height="190"
                       Visibility="{Binding ShowLog, Converter={StaticResource BoolToVisibility}}" />

        <!-- Chart or about -->
        <Grid>
            <views:ChartPane Visibility="{Binding IsTestTab, Converter={StaticResource BoolToVisibility}}" />
            <views:AboutPane Visibility="{Binding IsAboutTab, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</Window>
